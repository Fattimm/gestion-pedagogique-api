  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Referentiel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "libelle": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Promotion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "libelle": {
            "type": "string"
          },
          "date_debut": {
            "type": "string",
            "format": "date"
          },
          "date_fin": {
            "type": "string",
            "format": "date"
          },
          "duree": {
            "type": "integer"
          },
          "etat": {
            "type": "string",
            "enum": ["en cours", "terminée", "annulée"]
          },
          "photo_couverture": {
            "type": "string"
          },
          "referentiels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Referentiel"
            }
          }
        }
      },
      "PromotionStats": {
        "type": "object",
        "properties": {
          "nombre_etudiants": {
            "type": "integer"
          },
          "taux_reussite": {
            "type": "number",
            "format": "float"
          },
          "nombre_referentiels": {
            "type": "integer"
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
